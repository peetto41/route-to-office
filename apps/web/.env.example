# apps/web — nothing here is a server-side secret; never add
# GOOGLE_MAPS_SERVER_API_KEY or anything else from apps/api's .env to this file.

# Base URL the frontend calls for our own API (server-side proxy target / SSR fetch).
API_BASE_URL=http://localhost:3000
WEB_PORT=3001

# Public browser key used only to load the Google Maps JavaScript SDK
# (RouteMap.client.vue). This is deliberately public — Google's security
# model for this key is an HTTP-referrer restriction, not secrecy — but it
# still must be provisioned per environment (dev/staging/prod each with their
# own key, restricted in Google Cloud Console to that environment's domain(s)
# and to the Maps JavaScript API only), not hardcoded or shared. It must never
# be used for server-side Directions/Geocoding calls — that's a separate,
# actually-secret key that lives only in apps/api's .env.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
