# apps/api — server-side only, never exposed to the client

# Google Maps Platform server API key (Directions API + Geocoding API). Unlike the
# previous OpenRouteService key, Google Cloud Console DOES support restricting this key —
# apply that restriction: limit it to only the Directions API and Geocoding API, and
# ideally also restrict it by server IP address (this app calls both APIs exclusively
# from apps/api, never from the browser). Still env-only, gitleaks-checked, rotate on
# suspected leak.
GOOGLE_MAPS_SERVER_API_KEY=

# Company office — the default destination when the client doesn't supply one.
COMPANY_NAME=[ชื่อบริษัท]
COMPANY_LAT=[xx.xxxxxx]
COMPANY_LNG=[xx.xxxxxx]

# Allowed browser origin for CORS — should match where apps/web is served from.
CORS_ORIGIN=http://localhost:3001

PORT=3000
