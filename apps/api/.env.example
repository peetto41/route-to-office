# apps/api — server-side only, never exposed to the client

# OpenRouteService API key (openrouteservice.org). No fine-grained restriction option
# exists on ORS's dashboard the way Google Cloud Console offers IP-restriction — treat
# this as a plain bearer secret: env-only, gitleaks-checked, rotate on suspected leak.
ORS_API_KEY=

# Company office — the default destination when the client doesn't supply one.
COMPANY_NAME=[ชื่อบริษัท]
COMPANY_LAT=[xx.xxxxxx]
COMPANY_LNG=[xx.xxxxxx]

# Allowed browser origin for CORS — should match where apps/web is served from.
CORS_ORIGIN=http://localhost:3001

PORT=3000
