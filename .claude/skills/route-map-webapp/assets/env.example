# apps/api — server-side only, never exposed to the client

# Google Maps Platform key, restricted (in Google Cloud Console) to Routes API,
# Geocoding API, and Map Tiles API, and to this server's egress IP.
GOOGLE_MAPS_API_KEY=

# Company office — the default destination when the client doesn't supply one.
COMPANY_NAME=
COMPANY_LAT=
COMPANY_LNG=

# "google" proxies Google's Map Tiles API (separately billed SKU).
# "osm" proxies OpenStreetMap tiles instead — no extra Google cost, good for local dev.
TILE_PROVIDER=osm

# Allowed browser origin for CORS — should match where apps/web is served from.
CORS_ORIGIN=http://localhost:3001

PORT=3000

# apps/web

# Base URL the frontend calls for our own API (server-side proxy target / SSR fetch).
# Never put the Google API key here — nothing in this section reaches the client bundle
# except what's explicitly listed, and this file has nothing that should be.
API_BASE_URL=http://localhost:3000
WEB_PORT=3001
